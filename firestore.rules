rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function myId() {
      return get(/databases/$(database)/documents/uidMap/$(request.auth.uid)).data.userId;
    }

    match /uidMap/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && uid == request.auth.uid;
      allow update, delete: if signedIn() && uid == request.auth.uid;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid && userId == request.resource.data.id;
      allow update: if signedIn() && resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /blocks/{targetId} {
        allow read, write: if signedIn() && userId == myId();
      }
      match /tokens/{tokenId} {
        allow read, write: if signedIn() && userId == myId();
      }
      match /contacts/{contactId} {
        allow read, write: if signedIn() && userId == myId();
      }
    }

    match /conversations/{conversationId}/messages/{messageId} {
      allow read: if signedIn() &&
        (resource.data.from == myId() || resource.data.to == myId());
      allow create: if signedIn() &&
        (request.resource.data.from == myId() || request.resource.data.to == myId());
      allow update: if signedIn() && resource.data.from == myId();
      allow delete: if false;
    }
  }
}
